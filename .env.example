# Copy to .env for local testing. On Railway set these in Variables (never commit real values).
NODE_ENV=development
APP_TZ=Asia/Kolkata
DB_DIR=./data
JWT_SECRET=            # 32+ random characters: openssl rand -hex 32
JWT_EXPIRES_IN=8h
AES_256_KEY=           # exactly 64 hex characters: openssl rand -hex 32  (NEVER change once live)
BCRYPT_ROUNDS=12
CRON_SECRET=
WEBHOOK_SECRET=
DISABLE_SCHEDULER=false
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_MOBILE=
# Optional
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
PUBLIC_URL=
CORS_ORIGINS=
# Rate limits (optional — defaults shown in src/middleware/rateLimits.js)
RL_AUTH_IP_MAX=40
RL_AUTH_IP_WINDOW_MIN=15
RL_CODE_PER_MOBILE_MAX=5
RL_CODE_WINDOW_MIN=60
RL_PUBLIC_MAX=120
RL_PUBLIC_WINDOW_SEC=60
RL_BILL_LINK_MAX=30
RL_USER_MAX=600
RL_USER_WINDOW_SEC=60
RL_IP_FLOOD_MAX=3000
AUTH_FREE_TRIES=5
AUTH_BACKOFF_BASE_SEC=30
AUTH_BACKOFF_MAX_MIN=15
MPIN_WIPE_AT=10
# Cloudflare R2 — off-site copy of ID documents + database backups (all four needed; leave empty to keep R2 off)
R2_ACCOUNT_ID=9c8b3a2ba6fd0705bc27855ea12f7b0a
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# R2_ENDPOINT=https://9c8b3a2ba6fd0705bc27855ea12f7b0a.r2.cloudflarestorage.com   (optional, this is the default)
# R2_BACKUP_KEEP=30
